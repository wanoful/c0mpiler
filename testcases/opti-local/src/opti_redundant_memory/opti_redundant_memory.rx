struct Slot {
    head: i32,
    data: [i32; 256],
}

fn main() {
    let mut slot = Slot { head: 0, data: [0; 256] };
    let mut out: [i32; 512] = [0; 512];
    let mut i: i32 = 0;
    let mut acc: i32 = 0;

    while (i < 4096) {
        slot.head = (slot.head + 1) % 256;
        slot.data[slot.head as usize] = i ^ (acc & 255);
        slot.data[slot.head as usize] = i ^ (acc & 255);

        let v: i32 = slot.data[slot.head as usize];
        out[(i % 512) as usize] = v + slot.head;
        out[(i % 512) as usize] = v + slot.head;

        acc = (acc + out[(i % 512) as usize]) % 1000003;
        i += 1;
    }

    printlnInt(acc);
    printlnInt(slot.data[17]);
    printlnInt(out[255]);
    exit(0);
}
