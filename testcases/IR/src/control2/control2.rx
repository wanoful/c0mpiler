// control2: control flow heavy with values, side effects, loops as expressions
struct Counter { n: i32 }

fn inc(c: &mut Counter) -> i32 {
    c.n = c.n + 1;
    c.n
}

fn main() {
    let mut c: Counter = Counter { n: 0 };
    
    // if-else as expression value
    let a: i32 = if (inc(&mut c) > 0) { 10 } else { 20 };
    printlnInt(a);            // 10
    printlnInt(c.n);          // 1
    
    // nested if-else
    let b: i32 = if (c.n == 1) {
        if (inc(&mut c) > 1) { 100 } else { 200 }
    } else {
        300
    };
    printlnInt(b);            // 100
    printlnInt(c.n);          // 2
    
    // loop with break value
    let mut i: i32 = 0;
    let r: i32 = loop {
        i = i + 1;
        if (i > 5) { break i * 10; }
    };
    printlnInt(r);            // 60
    
    // while with side-effect condition
    let mut sum: i32 = 0;
    while (inc(&mut c) < 6) {
        sum = sum + c.n;
    }
    printlnInt(sum);          // c=3,4,5: 3+4+5 = 12
    printlnInt(c.n);          // 6
    
    // assignment in nested blocks
    let mut x: i32 = 0;
    {
        let y: i32 = {
            let z: i32 = 7;
            z + 3
        };
        x = y * 2;
    }
    printlnInt(x);            // 20
    
    // early return paths
    printlnInt(early(0));     // -1
    printlnInt(early(5));     // 5
    printlnInt(early(100));   // 99
    
    // chained if-else-if
    printlnInt(classify(3));  // 1
    printlnInt(classify(7));  // 2
    printlnInt(classify(15)); // 3
    printlnInt(classify(50)); // 4
    
    // break inside nested loops
    let mut total: i32 = 0;
    let mut p: i32 = 0;
    while (p < 5) {
        let mut q: i32 = 0;
        while (q < 5) {
            if (q == 3) { break; }
            total = total + 1;
            q = q + 1;
        }
        p = p + 1;
    }
    printlnInt(total);        // 15
    
    // continue with side-effect counter
    let mut acc: i32 = 0;
    let mut k: i32 = 0;
    while (k < 10) {
        k = k + 1;
        if (k % 2 == 0) { continue; }
        acc = acc + k;
    }
    printlnInt(acc);          // 1+3+5+7+9 = 25
    
    exit(0);
}

fn early(n: i32) -> i32 {
    if (n == 0) { return -1; }
    if (n < 10) { return n; }
    return 99;
}

fn classify(n: i32) -> i32 {
    if (n < 5) { 1 }
    else if (n < 10) { 2 }
    else if (n < 20) { 3 }
    else { 4 }
}
